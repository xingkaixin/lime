{
  "name": "Lime",
  "identifier": "me.xingkaixin.lime",
  "version": "0.1.0",
  "main": "./cmd/lime",
  "out": "build",
  "i18n": { "dir": "locales", "source": "en" },
  "macos": {
    "infoPlist": {
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "Document",
          "CFBundleTypeRole": "Editor",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["public.text", "public.data", "public.folder"]
        }
      ]
    }
  }
}
