{
  "name": "Lime",
  "identifier": "me.xingkaixin.lime",
  "version": "0.2.0",
  "main": "./cmd/lime",
  "out": "build",
  "resources": ["cmd/lime/fileicons/LICENSE-pierre-icons.md"],
  "i18n": { "dir": "locales", "source": "en" },
  "updates": {
    "publicKey": "ZEjKEsm/54wjyUcbbHClx+yhQ2rcUHrWZYYD/OXCgpk=",
    "github": "xingkaixin/lime"
  },
  "macos": {
    "minimumSystemVersion": "13.0",
    "infoPlist": {
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "Document",
          "CFBundleTypeRole": "Editor",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["public.text", "public.data", "public.folder"]
        }
      ]
    }
  }
}
